# Build output
build/
out/
.cache/

# Exported neural models are large binaries — do not commit.
models/*.onnx

# Vendored dependencies: ignore contents but keep each dir's README.md.
third_party/*/*
!third_party/*/README.md

# Session scratch: downloaded installers, probe scripts, generated configs
tools/_dl/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
