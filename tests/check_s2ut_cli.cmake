# --s2ut / --list-langs CLI checks (M3 stage 08). Every case must fail (or
# succeed) for the intended reason before any audio device is opened.
#   -DEXE=<fluxvoice> -DS2UT=<tests/data/fixtures/s2ut> -DIDENTITY=<.../identity> -DCASE=<name>
# One CTest per CASE so a failure names the rejected scenario.
function(expect_error needle)
    execute_process(COMMAND "${EXE}" ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(rc EQUAL 0)
        message(FATAL_ERROR "Unexpected success: ${ARGN}\n${out}${err}")
    endif()
    string(FIND "${out}${err}" "${needle}" match)
    if(match EQUAL -1)
        message(FATAL_ERROR "${ARGN}\nExpected '${needle}', got:\n${out}${err}")
    endif()
endfunction()

function(expect_ok)
    cmake_parse_arguments(P "" "" "NEEDLES;ARGS" ${ARGN})
    execute_process(COMMAND "${EXE}" ${P_ARGS}
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${P_ARGS} failed (${rc}):\n${out}${err}")
    endif()
    foreach(needle IN LISTS P_NEEDLES)
        string(FIND "${out}" "${needle}" match)
        if(match EQUAL -1)
            message(FATAL_ERROR "${P_ARGS}\nExpected '${needle}', got:\n${out}${err}")
        endif()
    endforeach()
endfunction()

set(known_case FALSE)
macro(case name)
    if("${CASE}" STREQUAL "${name}")
        set(known_case TRUE)
    endif()
endmacro()

case(no_src)
if(CASE STREQUAL "no_src")
    expect_error("requires --src-lang" --s2ut --model-dir "${S2UT}" --tgt-lang en)
endif()
case(no_tgt)
if(CASE STREQUAL "no_tgt")
    expect_error("requires --src-lang" --s2ut --model-dir "${S2UT}" --src-lang es)
endif()
case(unknown_lang)
if(CASE STREQUAL "unknown_lang")
    expect_error("unknown --src-lang 'xx' (bundle languages: en es fr de)"
                 --s2ut --model-dir "${S2UT}" --src-lang xx --tgt-lang en)
    expect_error("unknown --tgt-lang 'zz'" --s2ut --model-dir "${S2UT}" --src-lang es --tgt-lang zz)
endif()
case(same_lang)
if(CASE STREQUAL "same_lang")
    expect_error("use --vc" --s2ut --model-dir "${S2UT}" --src-lang en --tgt-lang en)
endif()
case(wait_k_0)
if(CASE STREQUAL "wait_k_0")
    expect_error("Invalid value for --wait-k" --s2ut --model-dir "${S2UT}" --src-lang es --tgt-lang en --wait-k 0)
endif()
case(wait_k_11)
if(CASE STREQUAL "wait_k_11")
    expect_error("Invalid value for --wait-k" --s2ut --model-dir "${S2UT}" --src-lang es --tgt-lang en --wait-k 11)
    expect_error("Invalid value for --wait-k" --s2ut --model-dir "${S2UT}" --src-lang es --tgt-lang en --wait-k abc)
endif()
case(lang_without_s2ut)
if(CASE STREQUAL "lang_without_s2ut")
    expect_error("require --s2ut" --src-lang es)
    expect_error("require --s2ut" --model-dir "${S2UT}" --wait-k 3)
endif()
case(no_model_dir)
if(CASE STREQUAL "no_model_dir")
    expect_error("--s2ut requires --model-dir" --s2ut --src-lang es --tgt-lang en)
endif()
case(loopback)
if(CASE STREQUAL "loopback")
    expect_error("ordinary duplex capture" --s2ut --loopback-input default)
    expect_error("ordinary duplex capture" --s2ut --list-devices)
    expect_error("mutually exclusive" --s2ut --vc)
    expect_error("mutually exclusive" --passthrough --s2ut)
endif()
case(no_langs_json)
if(CASE STREQUAL "no_langs_json")
    expect_error("langs.json" --s2ut --model-dir "${IDENTITY}" --src-lang es --tgt-lang en)
endif()
case(list_langs)
if(CASE STREQUAL "list_langs")
    expect_error("--list-langs requires --model-dir" --list-langs)
    expect_ok(ARGS --list-langs --model-dir "${S2UT}" NEEDLES "Spanish" "es->en")
endif()
case(list_params_langs)
if(CASE STREQUAL "list_params_langs")
    expect_ok(ARGS --list-params --json --model-dir "${S2UT}" NEEDLES "default_wait_k")
endif()
case(without_ort)
if(CASE STREQUAL "without_ort")
    expect_error("built without ONNX Runtime" --s2ut --model-dir "${S2UT}" --src-lang es --tgt-lang en)
endif()

if(NOT known_case)
    message(FATAL_ERROR "unknown CASE '${CASE}'")
endif()
