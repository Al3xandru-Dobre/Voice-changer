{
  "description": "Position counter state_in.src_pos must be i64",
  "error": "position state 'src_pos' has dtype f32, contract expects i64",
  "models": [
    {
      "contract": {
        "contract_version": 2,
        "role": "translator_enc",
        "sample_rate": 16000,
        "frame_samples": 320,
        "chunk_frames": 4,
        "latent_dim": 128,
        "max_src_steps": 128,
        "shared_mem_states": ["mem_k_0"],
        "langs": {"en": 0, "es": 1},
        "has_readiness_output": false,
        "states": ["src_pos", "mem_k_0"],
        "license": "MIT"
      },
      "graph": {
        "inputs": [
          {"name": "latents", "dtype": "f32", "shape": [1, 4, 128]},
          {"name": "src_lang", "dtype": "i64", "shape": [1]},
          {"name": "state_in.src_pos", "dtype": "f32", "shape": [1]},
          {"name": "state_in.mem_k_0", "dtype": "f32", "shape": [1, 4, 128, 64]}
        ],
        "outputs": [
          {"name": "state_out.src_pos", "dtype": "f32", "shape": [1]},
          {"name": "state_out.mem_k_0", "dtype": "f32", "shape": [1, 4, 128, 64]}
        ]
      }
    }
  ]
}
