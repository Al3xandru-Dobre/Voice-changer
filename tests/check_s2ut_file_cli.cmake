# fv_s2ut_file rejections must fail (non-zero exit) for the intended reason:
# the message needle must appear. Argument errors come before the ORT check, so
# the first cases run in ORT-less builds too; the language/WAV cases need a
# loaded bundle (ORT builds only). Inputs: EXE, CASE, BUNDLE.
set(_base --model-dir "${BUNDLE}" --src-lang es --tgt-lang de)

if(CASE STREQUAL "no_args")
    set(_needle "Missing required --model-dir")
    set(_args)
elseif(CASE STREQUAL "unknown_opt")
    set(_needle "Unknown option: --bogus")
    set(_args --bogus)
elseif(CASE STREQUAL "wait_k_0")
    set(_needle "Invalid --wait-k '0'")
    set(_args ${_base} --wait-k 0 in.wav out.wav)
elseif(CASE STREQUAL "wait_k_11")
    set(_needle "Invalid --wait-k '11'")
    set(_args ${_base} --wait-k 11 in.wav out.wav)
elseif(CASE STREQUAL "fps_3")
    set(_needle "Invalid --frames-per-step '3'")
    set(_args ${_base} --frames-per-step 3 in.wav out.wav)
elseif(CASE STREQUAL "bad_change")
    set(_needle "Invalid --change 'abc'")
    set(_args ${_base} --change abc in.wav out.wav)
elseif(CASE STREQUAL "bad_param")
    set(_needle "--param: unknown parameter")
    set(_args ${_base} --param bogus=1 in.wav out.wav)
elseif(CASE STREQUAL "missing_wavs")
    set(_needle "Expected <in.wav> and <out.wav>")
    set(_args ${_base})
elseif(CASE STREQUAL "without_ort")
    set(_needle "built without ONNX Runtime")
    set(_args ${_base} in.wav out.wav)
elseif(CASE STREQUAL "unknown_lang")
    set(_needle "unknown target language 'xx'")
    set(_args --model-dir "${BUNDLE}" --src-lang es --tgt-lang xx in.wav out.wav)
elseif(CASE STREQUAL "same_lang")
    set(_needle "must differ")
    set(_args --model-dir "${BUNDLE}" --src-lang es --tgt-lang 1 in.wav out.wav)
elseif(CASE STREQUAL "missing_input_wav")
    set(_needle "cannot open input WAV")
    set(_args ${_base} /nonexistent/in.wav out.wav)
else()
    message(FATAL_ERROR "unknown CASE '${CASE}'")
endif()

execute_process(COMMAND "${EXE}" ${_args}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(rc EQUAL 0)
    message(FATAL_ERROR "${CASE}: unexpected success\n${out}${err}")
endif()
string(FIND "${out}${err}" "${_needle}" match)
if(match EQUAL -1)
    message(FATAL_ERROR "${CASE}: expected '${_needle}' (exit ${rc}), got:\n${out}${err}")
endif()
