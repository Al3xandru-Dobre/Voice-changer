# CLI rejection tests must fail for the intended reason, before audio opens.
function(expect_error needle)
    execute_process(COMMAND "${EXE}" ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(rc EQUAL 0)
        message(FATAL_ERROR "Unexpected success: ${ARGN}\n${out}${err}")
    endif()
    string(FIND "${out}${err}" "${needle}" match)
    if(match EQUAL -1)
        message(FATAL_ERROR "${ARGN}\nExpected '${needle}', got:\n${out}${err}")
    endif()
endfunction()

expect_error("require --vc" --model-dir "${FIXTURES}")
expect_error("require --vc" --voice identity)
expect_error("require --vc" --frames-per-step 2)
expect_error("require --vc" --latency-target-ms 55)
expect_error("require --vc" --list-voices)
expect_error("mutually exclusive" --passthrough --vc)
expect_error("must be 1, 2 or 4" --vc --frames-per-step 3)
expect_error("Invalid value" --vc --latency-target-ms 0)
expect_error("Missing value" --vc --model-dir --voice identity)
expect_error("ordinary duplex capture" --vc --loopback-input default)
if(HAS_ORT)
    expect_error("requires --model-dir" --vc)
    expect_error("directory not found" --vc --model-dir "${FIXTURES}/missing" --voice identity)
    expect_error("unknown voice" --vc --model-dir "${FIXTURES}" --voice missing)
    expect_error("model contract rate" --vc --model-dir "${FIXTURES}" --voice identity --sample-rate 8000)
    expect_error("queue capacity" --vc --model-dir "${FIXTURES}" --voice identity --latency-target-ms 10000)
endif()
execute_process(
    COMMAND "${EXE}" --vc --model-dir "${FIXTURES}" --list-voices
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT out MATCHES "identity_b")
    message(FATAL_ERROR "Voice listing failed (${rc}): ${out}${err}")
endif()
